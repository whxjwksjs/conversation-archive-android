{
  "system_instruction": "You are a concise assistant. Answer in British English.",
  "messages": [
    { "role": "user", "content": "What is 17 * 23?" },
    { "role": "assistant", "content": "391." },
    { "role": "user", "content": "Show it in Python." },
    {
      "role": "assistant",
      "content": "```python\nprint(17 * 23)\n```"
    }
  ]
}
